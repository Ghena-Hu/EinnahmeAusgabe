@model EinnahmeAusgabe.Models.StatistikViewModel

@{
    ViewData["Title"] = "Statistiken";
}

<h1>Statistiken</h1>

<hr />

<!-- Datumsfilter -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="row">

        <div class="col-md-4">
            <label asp-for="DatumVon" class="form-label">
                Datum von
            </label>

            <input asp-for="DatumVon"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-4">
            <label asp-for="DatumBis" class="form-label">
                Datum bis
            </label>

            <input asp-for="DatumBis"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-primary">
                Filtern
            </button>
        </div>

    </div>
</form>

<!-- Statistiken -->
<div class="row mb-4">

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Summe Einnahmen</h5>
                <h3>@Model.SummeEinnahmen.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Summe Ausgaben</h5>
                <h3>@Model.SummeAusgaben.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Ø Einnahmen</h5>
                <h3>@Model.DurchschnittEinnahmen.ToString("C")</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5>Ø Ausgaben</h5>
                <h3>@Model.DurchschnittAusgaben.ToString("C")</h3>
            </div>
        </div>
    </div>

</div>

<!-- Top 5 -->
<div class="row">

    <div class="col-md-6">
        <h3>Top 5 Einnahmen</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Bezeichnung</th>
                    <th>Betrag</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var einnahme in Model.TopEinnahmen)
                {
                    <tr>
                        <td>@einnahme.Bezeichnung</td>
                        <td>@einnahme.Betrag.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h3>Top 5 Ausgaben</h3>

        <table class="table">
            <thead>
                <tr>
                    <th>Bezeichnung</th>
                    <th>Betrag</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var ausgabe in Model.TopAusgaben)
                {
                    <tr>
                        <td>@ausgabe.Bezeichnung</td>
                        <td>@ausgabe.Betrag.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Chart -->
<h3 class="mt-4">Top 5 Einnahmen und Ausgaben</h3>

<canvas id="statistikChart"></canvas>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const einnahmenLabels = [
        @Html.Raw(string.Join(",", Model.TopEinnahmen.Select(x =>
            "'" + x.Bezeichnung.Replace("'", "\\'") + "'")))
    ];

    const einnahmenWerte = [
        @Html.Raw(string.Join(",", Model.TopEinnahmen.Select(x =>
                        x.Betrag.ToString(System.Globalization.CultureInfo.InvariantCulture))))
    ];

    const ausgabenLabels = [
        @Html.Raw(string.Join(",", Model.TopAusgaben.Select(x =>
                        "'" + x.Bezeichnung.Replace("'", "\\'") + "'")))
    ];

    const ausgabenWerte = [
        @Html.Raw(string.Join(",", Model.TopAusgaben.Select(x =>
                        x.Betrag.ToString(System.Globalization.CultureInfo.InvariantCulture))))
    ];

    const labels = [...new Set([
        ...einnahmenLabels,
        ...ausgabenLabels
    ])];

    const einnahmenData = labels.map(label => {
        const index = einnahmenLabels.indexOf(label);
        return index >= 0 ? einnahmenWerte[index] : 0;
    });

    const ausgabenData = labels.map(label => {
        const index = ausgabenLabels.indexOf(label);
        return index >= 0 ? ausgabenWerte[index] : 0;
    });

    new Chart(document.getElementById("statistikChart"), {
        type: "bar",
        data: {
            labels: labels,
            datasets: [
                {
                    label: "Einnahmen",
                    data: einnahmenData
                },
                {
                    label: "Ausgaben",
                    data: ausgabenData
                }
            ]
        },
        options: {
            responsive: true
        }
    });
</script>