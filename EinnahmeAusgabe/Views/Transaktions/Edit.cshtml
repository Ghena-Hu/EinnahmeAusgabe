@model EinnahmeAusgabe.Models.Transaktion

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Transaktion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Bezeichnung" class="control-label"></label>
                <input asp-for="Bezeichnung" class="form-control" />
                <span asp-validation-for="Bezeichnung" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Betrag" class="control-label"></label>
                <input asp-for="Betrag" class="form-control" />
                <span asp-validation-for="Betrag" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Erstellungsdatum" class="control-label"></label>
                <input asp-for="Erstellungsdatum" class="form-control" />
                <span asp-validation-for="Erstellungsdatum" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Typ" class="control-label"></label>
                <input asp-for="Typ" class="form-control" />
                <span asp-validation-for="Typ" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="KategorieId" class="control-label">Kategorie</label>
                <select asp-for="KategorieId" class="form-control"
                        asp-items="ViewBag.KategorieId">
                    <option value="">-- Keine Kategorie --</option>
                </select>
                <span asp-validation-for="KategorieId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Kategorie" class="control-label"></label>
                <input asp-for="Kategorie" class="form-control" />
                <span asp-validation-for="Kategorie" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
